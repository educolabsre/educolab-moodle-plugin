<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
  integrity="sha384-tViUnnbYAV00FLIhhi3v/dWt3Jxw4gZQcNoSCxCIFNJVCx7/D55/wXsrNIRANwdD"
  crossorigin="anonymous"
/>

<div class="plugin-navbar mb-3">
  <i class="bi bi-arrow-left arrow page" id="back-arrow"></i>
  <h5 class="m-0">{{#str}} pluginname, block_educolab {{/str}}</h5>
</div>

<div
  id="forum-info"
  data-forumid="{{forumID}}"
  data-courseid="{{courseID}}"
  data-identificaforum="{{identifica_forum}}"
  data-nomeprofessor="{{nome_professor}}"
  data-linkforum="{{link_forum}}"
  data-emailprofessor="{{email_professor}}"
  data-confirmacao="{{confirmation_text}}"
  data-apibaseurl="{{api_base_url}}"
  data-streamliturl="{{streamlit_url}}"
/>

<div class="list-group page active" id="page-initialState">
  {{#is_teacher}}

  <button
    class="list-group-item list-group-item-action border-0 px-0 d-flex align-items-center justify-content-between"
    id="cadastro"
  >
    <span id="monitoramento"
      >{{#str}} start_monitoring, block_educolab {{/str}}</span
    >
    <i class="bi bi-chevron-right"></i>
  </button>

  <button
    class="list-group-item list-group-item-action border-0 px-0 d-flex align-items-center justify-content-between disabled"
    id="analise"
  >
    <div>
      {{#str}} analyze_forum, block_educolab {{/str}}
      <small class="d-block text-muted"
        >{{#str}} request_immediate_analysis, block_educolab {{/str}}</small
      >
    </div>
    <i class="bi bi-chevron-right"></i>
  </button>

  <button
    class="list-group-item list-group-item-action border-0 px-0 d-flex align-items-center justify-content-between disabled"
    id="recorrencia"
  >
    <div>
      {{#str}} schedule_analyses, block_educolab {{/str}}
      <small class="d-block text-muted"
        >{{#str}} configure_automatic_analyses, block_educolab {{/str}}</small
      >
    </div>
    <i class="bi bi-chevron-right"></i>
  </button>

  <button
    class="list-group-item list-group-item-action border-0 px-0 d-flex align-items-center justify-content-between"
    id="personalizar"
  >
    <div>
      {{#str}} customize, block_educolab {{/str}}
      <small class="d-block"
        >{{#str}} edit_recommendations, block_educolab {{/str}}</small
      >
    </div>
    <i class="bi bi-chevron-right"></i>
  </button>

  <button
    class="list-group-item list-group-item-action border-0 px-0 d-flex align-items-center justify-content-between"
    id="ver-recomendacao"
  >
    <div>
      {{#str}} view_last_recommendation, block_educolab {{/str}}
      <small class="d-block text-muted"
        >{{#str}} open_recommendations_panel, block_educolab {{/str}}</small
      >
    </div>
    <i class="bi bi-chevron-right"></i>
  </button>

  {{/is_teacher}} {{^is_teacher}} {{#student_enrolled}}

  <button
    class="list-group-item list-group-item-action border-0 px-0 d-flex align-items-center justify-content-between"
    id="ver-recomendacao-aluno"
  >
    <div>
      {{#str}} view_last_recommendation, block_educolab {{/str}}
      <small class="d-block text-muted"
        >{{#str}} open_recommendations_panel, block_educolab {{/str}}</small
      >
    </div>
    <i class="bi bi-chevron-right"></i>
  </button>

  <button
    class="list-group-item list-group-item-action border-0 px-0 d-flex align-items-center justify-content-between"
    id="atualizar-consentimento"
  >
    <div>
      {{#str}} update_consent, block_educolab {{/str}}
      <small class="d-block text-muted"
        >{{#str}} manage_monitoring_participation, block_educolab
        {{/str}}</small
      >
    </div>
    <i class="bi bi-chevron-right"></i>
  </button>

  {{/student_enrolled}} {{^student_enrolled}}
  <div class="text-muted p-2">
    <small>{{#str}} not_enrolled_monitoring, block_educolab {{/str}}</small>
  </div>
  {{/student_enrolled}} {{/is_teacher}}
</div>

<div id="page-cadastro" class="page">
  {{#is_teacher}}
  <div class="mt-4">
    <form>
      <div id="start-date-input">
        <label for="start-date" class="form-label"
          >{{#str}} monitoring_start, block_educolab {{/str}}</label
        >
        <input
          type="date"
          id="start-date"
          name="start-date"
          class="form-control mb-4"
          onchange="validateDates()"
          required
        />
      </div>

      <label for="end-date" class="form-label"
        >{{#str}} monitoring_end, block_educolab {{/str}}</label
      >

      <input
        type="date"
        id="end-date"
        name="end-date"
        class="form-control"
        onchange="validateDates()"
        value="{{forum_end_date}}"
        required
      />

      <button
        type="button"
        class="btn btn-dark mt-5 float-end"
        id="btn-cadastro"
      >
        <span id="button-monitoramento"
          >{{#str}} start_monitoring, block_educolab {{/str}}</span
        >
        <span
          class="spinner-border spinner-border-sm d-none"
          role="status"
          aria-hidden="true"
        ></span>
      </button>
    </form>
  </div>
  {{/is_teacher}}
</div>

<div id="page-analise" class="page">
  <div class="mt-4">
    <div>{{#str}} request_analysis_question, block_educolab {{/str}}</div>

    <button type="button" class="btn btn-dark mt-5 float-end" id="btn-analise">
      {{#str}} request_analysis, block_educolab {{/str}}
      <span
        class="spinner-border spinner-border-sm d-none"
        role="status"
        aria-hidden="true"
      ></span>
    </button>
  </div>
</div>

<div id="page-recorrencia" class="page">
  {{#is_teacher}}
  <div class="block-educolab-settings">
    <form id="educolab-schedule-form" method="post">
      <div class="form-group">
        <label for="interval"
          >{{#str}} configure_recurrence, block_educolab {{/str}}</label
        >

        <select id="interval" name="interval" class="w-100 custom-select">
          <option value="daily">{{#str}} daily, block_educolab {{/str}}</option>
          <option value="weekly">
            {{#str}} weekly, block_educolab {{/str}}
          </option>
          <option value="two_weeks">
            {{#str}} two_weeks, block_educolab {{/str}}
          </option>
          <option value="three_weeks">
            {{#str}} three_weeks, block_educolab {{/str}}
          </option>
          <option value="monthly">
            {{#str}} monthly, block_educolab {{/str}}
          </option>
        </select>
      </div>

      <div class="form-group">
        <label for="start_date"
          >{{#str}} start_on, block_educolab {{/str}}</label
        >
        <input
          type="date"
          id="start_date"
          name="start_date"
          class="form-control"
          value="{{scheduled_start_date}}"
        />
      </div>

      <button
        type="button"
        id="save-schedule-btn"
        class="btn btn-dark mt-3 float-end"
      >
        {{#str}} save, block_educolab {{/str}}
      </button>
    </form>
  </div>
  {{/is_teacher}}
</div>

<div id="page-personalizar" class="page">
  {{#is_teacher}}
  <div class="block-educolab-settings">
    <span>
      {{#str}} customize_text_settings, block_educolab {{/str}}

      <br /><br />

      {{#str}} confirmation_email_variables, block_educolab {{/str}}

      <span
        data-toggle="tooltip"
        title="{{#str}} student_name, block_educolab {{/str}}"
        class="text-primary"
        >['Nome']</span
      >,

      <span
        data-toggle="tooltip"
        title="{{#str}} forum_name, block_educolab {{/str}}"
        class="text-primary"
        >['identifica_forum']</span
      >

      e

      <span
        data-toggle="tooltip"
        title="{{#str}} confirmation_link, block_educolab {{/str}}"
        class="text-primary"
        >['link']</span
      >

      {{#str}} available, block_educolab {{/str}}
    </span>
  </div>
  {{/is_teacher}}
</div>

<div id="page-consentimento" class="page">
  <div class="mt-4">
    <h6>{{#str}} participation_consent, block_educolab {{/str}}</h6>

    <p class="text-muted">
      {{#str}} consent_description, block_educolab {{/str}}
    </p>

    <div id="consent-status" class="mb-3">
      <span
        class="badge {{#student_consented}}badge-success{{/student_consented}}{{^student_consented}}badge-secondary{{/student_consented}}"
      >
        {{#str}} current_status, block_educolab {{/str}}: {{#student_consented}}
        {{#str}} consented, block_educolab {{/str}} {{/student_consented}}
        {{^student_consented}} {{#str}} not_consented, block_educolab {{/str}}
        {{/student_consented}}
      </span>
    </div>

    <div class="d-flex gap-2 mt-4">
      <button
        type="button"
        class="btn btn-success flex-fill"
        id="btn-consentir"
      >
        <i class="bi bi-check-circle"></i> {{#str}} consent, block_educolab
        {{/str}}
        <span
          class="spinner-border spinner-border-sm d-none"
          role="status"
          aria-hidden="true"
        ></span>
      </button>

      <button
        type="button"
        class="btn btn-outline-danger flex-fill"
        id="btn-nao-consentir"
      >
        <i class="bi bi-x-circle"></i> {{#str}} withdraw_consent, block_educolab
        {{/str}}
        <span
          class="spinner-border spinner-border-sm d-none"
          role="status"
          aria-hidden="true"
        ></span>
      </button>
    </div>
  </div>
</div>

<div aria-live="polite" aria-atomic="true" class="position-fixed" style="bottom: 16px; right: 16px; z-index: 9999;">
  <div class="toast toast-success" role="alert" aria-live="assertive" aria-atomic="true" id="successToast">
    <div class="toast-header toast-header-success">
      <strong class="mr-auto" id='toast-header-title'>Titulo</strong>
      <button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <div class="toast-body">
      Mensagem
    </div>
  </div>
</div>
<script>
  window.educolab = window.educolab || {};

  window.educolab.students = JSON.parse("{{ estudantes }}".replace(/&quot;/g, '"'));
  window.educolab.messages = JSON.parse("{{ messages }}".replace(/&quot;/g, '"'));
  window.educolab.isTeacher = {{is_teacher}};

  console.log('EduColab is_teacher:', window.educolab.isTeacher);

  function validateDates() {
    const startDate = document.getElementById("start-date").value;
    const endDate = document.getElementById("end-date").value;

    if (startDate) {
      document.getElementById("end-date").setAttribute("min", startDate);
    }

    if (endDate) {
      document.getElementById("start-date").setAttribute("max", endDate);
    }
  }
</script>